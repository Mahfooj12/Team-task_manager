{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build",
    "nixPkgs": ["nodejs_20", "npm"],
    "phases": {
      "setup": {
        "nixPkgs": ["nodejs_20", "npm"]
      },
      "install": {
        "cmds": ["npm install"]
      },
      "build": {
        "cmds": ["npm run build"]
      }
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist",
    "restartPolicyType": "ON_FAILURE"
  }
}
