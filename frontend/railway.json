{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixPkgs": ["nodejs_20"],
    "phases": {
      "install": {
        "cmds": ["npm install"]
      },
      "build": {
        "cmds": ["npm run build"]
      }
    }
  },
  "deploy": {
    "startCommand": "npx serve -s dist"
  }
}
